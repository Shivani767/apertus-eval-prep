\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Decoding stochasticity versus determinism. Sampled columns use temperature 0.7, top-$p$ 0.95 with three different seeds; the range across seeds is in percentage points. Greedy-seed rows change only the RNG seed under temperature 0: the committed runs are item-for-item identical to the control (0 discordant pairs out of 800), so greedy seed variation contributes exactly zero measured variance in this harness.}}{13}{table.8}\protected@file@percent }
\newlabel{tab:sampling}{{8}{13}{Decoding stochasticity versus determinism. Sampled columns use temperature 0.7, top-$p$ 0.95 with three different seeds; the range across seeds is in percentage points. Greedy-seed rows change only the RNG seed under temperature 0: the committed runs are item-for-item identical to the control (0 discordant pairs out of 800), so greedy seed variation contributes exactly zero measured variance in this harness}{table.8}{}}
\newlabel{tab:sampling@cref}{{[table][8][]8}{[1][12][]13}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Greedy decoding is seed-invariant (three identical points per model; 0 discordant items in 800), while temperature-0.7 sampling (three seeds, Wilson 95\% intervals) produces seed-to-seed ranges of 2.0--2.8\,\ensuremath  {\mathrm  {pp}}{} on top of a systematic drift relative to greedy.}}{13}{figure.3}\protected@file@percent }
\newlabel{fig:sampling}{{3}{13}{Greedy decoding is seed-invariant (three identical points per model; 0 discordant items in 800), while temperature-0.7 sampling (three seeds, Wilson 95\% intervals) produces seed-to-seed ranges of 2.0--2.8\,\pp {} on top of a systematic drift relative to greedy}{figure.3}{}}
\newlabel{fig:sampling@cref}{{[figure][3][]3}{[1][13][]13}}
\@writefile{toc}{\contentsline {paragraph}{Greedy seed changes are exact no-ops.}{13}{section*.8}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Temperature-0.7 sampling produces churn with small drift.}{13}{section*.9}\protected@file@percent }
